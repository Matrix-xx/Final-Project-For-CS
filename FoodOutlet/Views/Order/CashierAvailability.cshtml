@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cashierTableAvail = (ViewData["CashierTableAvailability"] as List<dynamic>) ?? new List<dynamic>();
}
<partial name="_CashierWorkflowStyles" />

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0" style="font-size:1.3rem; font-weight:700;">
            <i class="fas fa-door-open mr-2 text-info"></i>
            @(ViewData["Title"] ?? "Cashier — Table availability")
            <span class="badge badge-info ml-2" id="totalBadge">@cashierTableAvail.Count</span>
        </h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="section-divider">
            <i class="fas fa-chair mr-1 text-info"></i>
            Table availability (QR ordering)
            <span class="badge badge-info ml-1">@cashierTableAvail.Count</span>
        </div>

        @if (!cashierTableAvail.Any())
        {
            <div class="empty-queue mb-4">
                <i class="fas fa-table text-muted"></i>
                <p>No tables registered yet. Add tables under Admin → Table Registration.</p>
            </div>
        }
        else
        {
            <div class="card card-outline card-secondary mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width:40%;">Table</th>
                                    <th>Status</th>
                                    <th style="width:220px;" class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in cashierTableAvail)
                                {
                                    var tid = (int)t.table_list_id;
                                    var isOpen = (int)t.is_available != 0;
                                    <tr id="tbl-avail-row-@tid">
                                        <td class="align-middle font-weight-bold">@t.table_name</td>
                                        <td class="align-middle">
                                            <span class="badge @(isOpen ? "badge-secondary" : "badge-success") tbl-avail-badge" data-tid="@tid">
                                                @(isOpen ? "Unavailable" : "Available")
                                            </span>
                                            <small class="text-muted d-block mt-1">Unavailable = guests can order. Available = ordering closed.</small>
                                        </td>
                                        <td class="align-middle text-right">
                                            @if (isOpen)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary tbl-avail-btn"
                                                        data-tid="@tid" data-action="mark-available">
                                                    <i class="fas fa-ban mr-1"></i>Mark Available
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-success tbl-avail-btn"
                                                        data-tid="@tid" data-action="mark-unavailable">
                                                    <i class="fas fa-check mr-1"></i>Mark Unavailable
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Toast notification container for error messages -->
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
</div>

<!-- Toast notification container for error messages -->
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
</div>

@section Scripts {
<script>
    // Track pending requests per table  to prevent double-submissions
    var pendingRequests = {};

    $(document).on('click', '.tbl-avail-btn', function (e) {
        e.preventDefault();
        var btn = $(this);
        var tid = parseInt(btn.data('tid'), 10);
        var action = btn.data('action');
        var makeAvail = action === 'mark-available';

        // Check if a request is already pending for this table
        if (pendingRequests[tid]) {
            console.log('Request already pending for table ' + tid);
            return;
        }

        // Mark request as pending
        pendingRequests[tid] = true;
        btn.prop('disabled', true);

        $.ajax({
            type: 'POST',
            url: '/api/order/set_table_availability',
            contentType: 'application/json',
            data: JSON.stringify({ table_list_id: tid, is_available: makeAvail }),
            timeout: 5000
        })
        .done(function (response) {
            console.log('Success: Table ' + tid + ' updated to ' + (makeAvail ? 'Available' : 'Unavailable'));
            updateTableRow(tid, makeAvail);
        })
        .fail(function (xhr, status, error) {
            var msg = 'Failed to update table status. Please try again.';
            if (xhr.responseJSON && xhr.responseJSON.message) {
                msg = xhr.responseJSON.message;
            } else if (xhr.status === 0) {
                msg = 'Network error. Please check your connection.';
            } else if (status === 'timeout') {
                msg = 'Request timeout. Please try again.';
            }
            console.error('Error updating table ' + tid + ':', error);
            alert(msg);
            
            // Restore button state on error
            var row = document.getElementById('tbl-avail-row-' + tid);
            if (row) {
                var button = row.querySelector('.tbl-avail-btn');
                if (button) {
                    button.disabled = false;
                }
            }
        })
        .always(function () {
            // Always clear the pending flag
            delete pendingRequests[tid];
        });
    });

    function updateTableRow(tid, isAvailable) {
        var row = document.getElementById('tbl-avail-row-' + tid);
        if (!row) return;

        // Update status badge
        var badge = row.querySelector('.tbl-avail-badge');
        if (badge) {
            badge.className = 'badge tbl-avail-badge ' + (isAvailable ? 'badge-success' : 'badge-secondary');
            badge.textContent = isAvailable ? 'Available' : 'Unavailable';
        }

        // Update action button
        var btn = row.querySelector('.tbl-avail-btn');
        if (btn) {
            if (isAvailable) {
                btn.className = 'btn btn-sm btn-success tbl-avail-btn';
                btn.setAttribute('data-action', 'mark-unavailable');
                btn.innerHTML = '<i class="fas fa-check mr-1"></i>Mark Unavailable';
            } else {
                btn.className = 'btn btn-sm btn-outline-secondary tbl-avail-btn';
                btn.setAttribute('data-action', 'mark-available');
                btn.innerHTML = '<i class="fas fa-ban mr-1"></i>Mark Available';
            }
            btn.disabled = false;
        }
    }
</script>
}
