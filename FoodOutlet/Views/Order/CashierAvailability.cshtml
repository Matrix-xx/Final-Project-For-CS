@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cashierTableAvail = (ViewData["CashierTableAvailability"] as List<dynamic>) ?? new List<dynamic>();
}
<partial name="_CashierWorkflowStyles" />

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0" style="font-size:1.3rem; font-weight:700;">
            <i class="fas fa-door-open mr-2 text-info"></i>
            @(ViewData["Title"] ?? "Cashier — Table availability")
            <span class="badge badge-info ml-2" id="totalBadge">@cashierTableAvail.Count</span>
        </h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="section-divider">
            <i class="fas fa-chair mr-1 text-info"></i>
            Table availability (QR ordering)
            <span class="badge badge-info ml-1">@cashierTableAvail.Count</span>
        </div>

        @if (!cashierTableAvail.Any())
        {
            <div class="empty-queue mb-4">
                <i class="fas fa-table text-muted"></i>
                <p>No tables registered yet. Add tables under Admin → Table Registration.</p>
            </div>
        }
        else
        {
            <div class="card card-outline card-secondary mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width:40%;">Table</th>
                                    <th>Status</th>
                                    <th style="width:220px;" class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in cashierTableAvail)
                                {
                                    var tid = (int)t.table_list_id;
                                    var isOpen = (int)t.is_available != 0;
                                    <tr id="tbl-avail-row-@tid">
                                        <td class="align-middle font-weight-bold">@t.table_name</td>
                                        <td class="align-middle">
                                            <span class="badge @(isOpen ? "badge-secondary" : "badge-success") tbl-avail-badge" data-tid="@tid">
                                                @(isOpen ? "Unavailable" : "Available")
                                            </span>
                                            <small class="text-muted d-block mt-1">Unavailable = guests can order. Available = ordering closed.</small>
                                        </td>
                                        <td class="align-middle text-right">
                                            @if (isOpen)
                                            {
                                                <button type="button" class="btn btn-sm btn-success tbl-avail-btn"
                                                        data-tid="@tid" data-action="mark-available">
                                                    <i class="fas fa-check mr-1"></i>Mark Available
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-success tbl-avail-btn"
                                                        data-tid="@tid" data-action="mark-unavailable">
                                                    <i class="fas fa-check mr-1"></i>Mark Unavailable
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Toast notification container for error messages -->
<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
</div>

<script>
(function () {
    // #region agent log
    function dbgLog(hypothesisId, location, message, data) {
        var payload = JSON.stringify({ sessionId: '0df4d3', runId: 'post-fix', hypothesisId: hypothesisId, location: location, message: message, data: data || {}, timestamp: Date.now() });
        fetch('http://127.0.0.1:7335/ingest/093ca928-03f9-49af-b8c1-b28b02424135', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Debug-Session-Id': '0df4d3' }, body: payload }).catch(function () {
            fetch('/__debug/browser-log', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload }).catch(function () {});
        });
    }
    // #endregion

    var pendingRequests = {};

    function updateTableRow(tid, showUiAvailable) {
        var row = document.getElementById('tbl-avail-row-' + tid);
        // #region agent log
        dbgLog('H3', 'CashierAvailability.cshtml:updateTableRow', 'dom update attempt', { tid: tid, showUiAvailable: showUiAvailable, rowFound: !!row });
        // #endregion
        if (!row) return;

        var badge = row.querySelector('.tbl-avail-badge');
        if (badge) {
            badge.className = 'badge tbl-avail-badge ' + (showUiAvailable ? 'badge-success' : 'badge-secondary');
            badge.textContent = showUiAvailable ? 'Available' : 'Unavailable';
        }

        var btn = row.querySelector('.tbl-avail-btn');
        if (btn) {
            if (showUiAvailable) {
                btn.className = 'btn btn-sm btn-success tbl-avail-btn';
                btn.setAttribute('data-action', 'mark-unavailable');
                btn.innerHTML = '<i class="fas fa-check mr-1"></i>Mark Unavailable';
            } else {
                btn.className = 'btn btn-sm btn-success tbl-avail-btn';
                btn.setAttribute('data-action', 'mark-available');
                btn.innerHTML = '<i class="fas fa-check mr-1"></i>Mark Available';
            }
            btn.disabled = false;
        }
        // #region agent log
        dbgLog('H3', 'CashierAvailability.cshtml:updateTableRow', 'dom update complete', { tid: tid, badgeText: badge ? badge.textContent : null });
        // #endregion
    }

    function onTableAvailClick(e) {
        var btn = e.target.closest('.tbl-avail-btn');
        if (!btn) return;
        e.preventDefault();

        var tid = parseInt(btn.getAttribute('data-tid'), 10);
        var action = btn.getAttribute('data-action');
        var showUiAvailable = action === 'mark-available';
        var dbAvailable = action === 'mark-unavailable';

        // #region agent log
        dbgLog('H1', 'CashierAvailability.cshtml:click', 'button clicked', { tid: tid, action: action, showUiAvailable: showUiAvailable, dbAvailable: dbAvailable, rowFound: !!document.getElementById('tbl-avail-row-' + tid) });
        // #endregion

        if (!tid || pendingRequests[tid]) return;

        pendingRequests[tid] = true;
        btn.disabled = true;

        fetch('/api/order/set_table_availability', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ table_list_id: tid, is_available: dbAvailable })
        })
        .then(function (res) {
            if (!res.ok) {
                return res.json().catch(function () { return {}; }).then(function (body) {
                    throw new Error(body.message || 'Failed to update table status.');
                });
            }
            return res.json();
        })
        .then(function (response) {
            // #region agent log
            dbgLog('H2', 'CashierAvailability.cshtml:fetch.done', 'api success', { tid: tid, showUiAvailable: showUiAvailable, dbAvailable: dbAvailable, response: response });
            // #endregion
            updateTableRow(tid, showUiAvailable);
        })
        .catch(function (err) {
            // #region agent log
            dbgLog('H2', 'CashierAvailability.cshtml:fetch.fail', 'api failed', { tid: tid, error: String(err) });
            // #endregion
            alert(err.message || 'Failed to update table status. Please try again.');
            btn.disabled = false;
        })
        .finally(function () {
            delete pendingRequests[tid];
        });
    }

    function initTableAvailability() {
        // #region agent log
        dbgLog('H1', 'CashierAvailability.cshtml:init', 'script loaded', { rowCount: document.querySelectorAll('[id^="tbl-avail-row-"]').length });
        // #endregion
        document.removeEventListener('click', onTableAvailClick);
        document.addEventListener('click', onTableAvailClick);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTableAvailability);
    } else {
        initTableAvailability();
    }
})();
</script>
