@{
    ViewData["Title"] = "Home Page";
    var isAdmin = User.FindFirst("RoleName")?.Value == "Admin";
}

@if (isAdmin)
{
    <style>
        .small-box .inner h3 {
            font-size: 1.2rem !important;
        }

        /* Large watermark-style icons — same visual language as Order History & Resign cards */
        .content .dashboard-small-box {
            position: relative;
            overflow: hidden;
        }
        .content .dashboard-small-box .icon {
            position: absolute;
            right: 0.6rem;
            top: 0.5rem;
            z-index: 0;
            pointer-events: none;
        }
        .content .dashboard-small-box .icon > i {
            font-size: 4.25rem;
            line-height: 1;
            opacity: 0.35;
            color:  blackgba(255, 255, 255, 0.95);
        }
        .content .dashboard-small-box.bg-warning .icon > i,
        .content .dashboard-small-box.bg-gradient-warning .icon > i {
            color: rgba(0, 0, 0, 0.18);
        }
        .content .dashboard-small-box .inner,
        .content .dashboard-small-box > .small-box-footer {
            position: relative;
            z-index: 1;
        }

        #incomeChartWrap {
            position: relative;
            height: 320px;
            width: 100%;
        }

        #categoryPieWrap,
        #topItemsBarWrap {
            position: relative;
            height: 280px;
            width: 100%;
        }

        .chart-filter-group .btn {
            min-width: 0;
            padding: 0.25rem 0.6rem;
            font-size: 0.85rem;
            white-space: nowrap;
        }

        .chart-filter-group .btn.active {
            background-color: #17a2b8;
            color: #fff;
            border-color: #17a2b8;
        }

        #chartTitle {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 1rem;
        }

        .chart-card-header {
            flex-wrap: nowrap;
            align-items: center;
            gap: 0.75rem;
            width: 100%;
        }

        .chart-card-header .chart-header-title-wrap {
            flex: 0 1 auto;
            min-width: 0;
            max-width: 42%;
        }

        .chart-card-header .chart-header-controls {
            flex: 1 1 0;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            min-width: 0;
            text-align: right;
        }

        .chart-period-summary {
            font-size: 0.8125rem;
            color: #495057;
            line-height: 1.35;
            flex: 0 1 auto;
            max-width: 100%;
        }

        .chart-card-header .card-title {
            float: none;
        }

        @@media (max-width: 576px) {
            .chart-card-header {
                flex-wrap: wrap;
            }
            .chart-card-header .chart-header-title-wrap {
                width: 100%;
                max-width: none;
            }
            .chart-card-header .chart-header-controls {
                width: 100%;
                flex: none;
                justify-content: flex-end;
            }
        }
    </style>
}

<div class="content-header">
    <div class="container-fluid"></div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (isAdmin)
        {
            <div class="row">
                <div class="col-lg-3 col-6">
                    <div class="small-box bg-info dashboard-small-box">
                        <div class="inner">
                            <h3 id="staffCount">0</h3>
                            <p>Total Staff</p>
                        </div>
                        <div class="icon"><i class="fas fa-users"></i></div>
                        <a href="@Url.Action("StaffList", "Entry")" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="small-box bg-success dashboard-small-box">
                        <div class="inner">
                            <h3 id="categoryCount">0</h3>
                            <p>Categories</p>
                        </div>
                        <div class="icon"><i class="fas fa-list-ul"></i></div>
                        <a href="@Url.Action("Category", "Entry")" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="small-box bg-warning dashboard-small-box">
                        <div class="inner">
                            <h3 id="recipeCount">0</h3>
                            <p>Recipes</p>
                        </div>
                        <div class="icon"><i class="fas fa-utensils"></i></div>
                        <a href="@Url.Action("RecipeList", "Entry")" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="small-box txt_white dashboard-small-box" style="background-color:mediumslateblue;">
                        <div class="inner">
                            <h3 id="roleCount">0</h3>
                            <p>Roles</p>
                        </div>
                        <div class="icon"><i class="fas fa-user-tag"></i></div>
                        <a href="@Url.Action("Role", "Entry")" class="small-box-footer txt_white">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="small-box bg-primary dashboard-small-box">
                        <div class="inner">
                            <h3 id="orderHistoryCount">0</h3>
                            <p>Table Order History</p>
                        </div>
                        <div class="icon"><i class="fas fa-history"></i></div>
                        <a href="@Url.Action("TableOrderHistory", "Entry")" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="small-box bg-danger dashboard-small-box">
                        <div class="inner">
                            <h3 id="resignMessageCount">0</h3>
                            <p>Resign Approval</p>
                        </div>
                        <div class="icon"><i class="fas fa-envelope"></i></div>
                        <a href="@Url.Action("ResignApproval", "Entry")" class="small-box-footer">Review <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card card-outline card-info">
                        <div class="card-header chart-card-header d-flex align-items-center">
                            <div class="chart-header-title-wrap">
                                <h3 class="card-title font-weight-bold mb-0" id="chartTitle">Sales Income (Last 7 Days)</h3>
                            </div>
                            <div class="chart-header-controls">
                                <div id="chartPeriodSummary" class="chart-period-summary mb-0"></div>
                                <div class="btn-group btn-group-sm chart-filter-group flex-shrink-0" role="group" aria-label="Chart range filter">
                                    <button type="button" class="btn btn-outline-info active" data-days="7" data-label="Last 7 Days">7D</button>
                                    <button type="button" class="btn btn-outline-info" data-days="30" data-label="Last 1 Month">1M</button>
                                    <button type="button" class="btn btn-outline-info" data-days="90" data-label="Last 3 Months">3M</button>
                                    <button type="button" class="btn btn-outline-info" data-days="180" data-label="Last 6 Months">6M</button>
                                    <button type="button" class="btn btn-outline-info" data-days="365" data-label="Last 1 Year">1Y</button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div id="incomeChartWrap">
                                <canvas id="incomeChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6 col-12 mb-4">
                    <div class="card card-outline card-success h-100">
                        <div class="card-header">
                            <h3 class="card-title font-weight-bold mb-0">Sales by category</h3>
                        </div>
                        <div class="card-body"> 
                            <div id="categoryPieWrap">
                                <canvas id="categoryPieChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-12 mb-4">
                    <div class="card card-outline card-primary h-100">
                        <div class="card-header">
                            <h3 class="card-title font-weight-bold mb-0">Top 5 selling items</h3>
                        </div>
                        <div class="card-body">
                            <div id="topItemsBarWrap">
                                <canvas id="topItemsBarChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
@if (isAdmin)
{
<script src="~/plugins/chart.js/Chart.min.js"></script>
<script>
    var dashLoaded = false;
    var incomeChart = null;
    var categoryPieChart = null;
    var topItemsBarChart = null;
    var piePalette = ['#17a2b8', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#007bff', '#6610f2'];

    $(document).ready(function () {
        if (dashLoaded) return;
        dashLoaded = true;
        loadCounts();
        reloadDashboard(7, 'Last 7 Days');

        $('.chart-filter-group .btn').on('click', function () {
            $('.chart-filter-group .btn').removeClass('active');
            $(this).addClass('active');
            var days = parseInt($(this).data('days'), 10) || 7;
            var label = $(this).data('label') || ('Last ' + days + ' Days');
            reloadDashboard(days, label);
        });
    });

    function reloadDashboard(days, title) {
        days = days || 7;
        title = title || ('Last ' + days + ' Days');
        loadSalesChart(days, title);
        loadCategoryPie(days);
        loadTopItemsBar(days);
    }

    function loadCounts() {
        $.ajax({
            type: 'GET',
            url: '/api/get_counts',
            cache: false,
            timeout: 10000
        }).done(function (res) {
            $('#staffCount').text(res.staff_count || 0);
            $('#categoryCount').text(res.category_count || 0);
            $('#recipeCount').text(res.recipe_count || 0);
            $('#roleCount').text(res.role_count || 0);
            $('#orderHistoryCount').text(res.order_history_count || 0);
            $('#resignMessageCount').text(res.resign_message_count || 0);
        }).fail(function () {
            console.error('Failed to load counts');
        });
    }

    function buildBucketKeys(days) {
        var keys = [];
        var labels = [];
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        if (days <= 31) {
            for (var i = days - 1; i >= 0; i--) {
                var d = new Date(today);
                d.setDate(today.getDate() - i);
                var k = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                keys.push(k);
                labels.push(monthNames[d.getMonth()] + ' ' + d.getDate());
            }
            return { granularity: 'day', keys: keys, labels: labels };
        }

        var months = days >= 365 ? 12 : (days >= 180 ? 6 : 3);
        for (var m = months - 1; m >= 0; m--) {
            var dt = new Date(today.getFullYear(), today.getMonth() - m, 1);
            var k = dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0');
            keys.push(k);
            labels.push(monthNames[dt.getMonth()] + ' ' + dt.getFullYear());
        }
        return { granularity: 'month', keys: keys, labels: labels };
    }

    function bucketSeries(series, granularity) {
        var totals = {};
        (series || []).forEach(function (it) {
            var dateStr = (it.sale_date || '').toString();
            if (!dateStr) return;
            var k = granularity === 'month' ? dateStr.substring(0, 7) : dateStr.substring(0, 10);
            totals[k] = (totals[k] || 0) + parseFloat(it.total_income || 0);
        });
        return totals;
    }

    function formatPeriodRangeText(bucket) {
        if (!bucket || !bucket.keys || bucket.keys.length === 0) return '';
        var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var first = bucket.keys[0];
        var last = bucket.keys[bucket.keys.length - 1];

        if (bucket.granularity === 'month') {
            function parseYm(k) {
                var parts = k.split('-');
                return { y: parseInt(parts[0], 10), m: parseInt(parts[1], 10) - 1 };
            }
            var a = parseYm(first);
            var b = parseYm(last);
            var s = monthNames[a.m] + ' ' + a.y;
            var e = monthNames[b.m] + ' ' + b.y;
            return s === e ? s : (s + ' – ' + e);
        }

        function parseDay(k) {
            var p = k.split('-');
            return new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
        }
        var d1 = parseDay(first);
        var d2 = parseDay(last);
        function fmt(d) {
            return monthNames[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();
        }
        return fmt(d1) + ' – ' + fmt(d2);
    }

    function formatMmk(value) {
        return Math.round(value).toLocaleString();
    }

    function loadSalesChart(days, title) {
        days = days || 7;
        title = title || ('Last ' + days + ' Days');
        $('#chartTitle').text('Sales Income (' + title + ')');

        $.get('/api/admin/sales_chart', { days: days }, function (res) {
            var bucket = buildBucketKeys(days);
            var totals = bucketSeries(res && res.series, bucket.granularity);
            var values = bucket.keys.map(function (k) { return totals[k] || 0; });
            var periodTotal = values.reduce(function (a, b) { return a + b; }, 0);
            var rangeText = formatPeriodRangeText(bucket);

            $('#chartPeriodSummary').html(
                '<strong>Period total:</strong> ' + formatMmk(periodTotal) + ' MMK &nbsp;|&nbsp; <strong>Duration:</strong> ' + rangeText
            );

            if (incomeChart) {
                incomeChart.destroy();
            }

            var ctx = document.getElementById('incomeChart').getContext('2d');
            var gradient = ctx.createLinearGradient(0, 0, 0, 320);
            gradient.addColorStop(0, 'rgba(23,162,184,0.45)');
            gradient.addColorStop(1, 'rgba(23,162,184,0.02)');

            incomeChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: bucket.labels,
                    datasets: [{
                        label: 'Income (MMK)',
                        data: values,
                        borderColor: '#17a2b8',
                        backgroundColor: gradient,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.35,
                        pointRadius: bucket.granularity === 'day' && days > 14 ? 2 : 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#17a2b8',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    legend: { display: false },
                    tooltips: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            label: function (item) {
                                return ' Income: ' + formatMmk(item.yLabel) + ' MMK';
                            }
                        }
                    },
                    hover: { mode: 'nearest', intersect: true },
                    scales: {
                        xAxes: [{
                            gridLines: { display: false },
                            ticks: {
                                autoSkip: true,
                                maxTicksLimit: 12,
                                maxRotation: 0
                            }
                        }],
                        yAxes: [{
                            gridLines: { color: 'rgba(0,0,0,0.06)' },
                            ticks: {
                                beginAtZero: true,
                                suggestedMax: 10,
                                callback: function (v) { return formatMmk(v); }
                            }
                        }]
                    }
                }
            });
        }).fail(function () {
            console.error('Failed to load sales chart');
        });
    }

    function loadCategoryPie(days) {
        $.get('/api/admin/sales_by_category', { days: days }, function (res) {
            var pieRows = (res && res.categories) ? res.categories : [];
            var labels = [];
            var vals = [];
            var colors = [];
            if (!pieRows.length) {
                labels.push('No paid sales in period');
                vals.push(1);
                colors.push('#dee2e6');
            } else {
                pieRows.forEach(function (r, i) {
                    labels.push(r.category_name || 'Uncategorized');
                    vals.push(parseFloat(r.total_income || 0));
                    colors.push(piePalette[i % piePalette.length]);
                });
            }
            var hasData = pieRows.length > 0;
            var sum = vals.reduce(function (a, b) { return a + b; }, 0);

            if (categoryPieChart) categoryPieChart.destroy();

            categoryPieChart = new Chart(document.getElementById('categoryPieChart').getContext('2d'), {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: vals,
                        backgroundColor: colors,
                        borderWidth: hasData ? 1 : 0,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    legend: { position: 'right' },
                    tooltips: {
                        callbacks: {
                            label: function (tooltipItem, data) {
                                if (!hasData) return ' No completed orders in this date range.';
                                var i = tooltipItem.index;
                                var name = data.labels[i] || '';
                                var v = parseFloat(data.datasets[0].data[i] || 0);
                                var pct = sum ? (Math.round(v / sum * 1000) / 10) : 0;
                                return ' ' + name + ': ' + formatMmk(v) + ' MMK (' + pct + '%)';
                            }
                        }
                    }
                }
            });
        }).fail(function () {
            console.error('Failed to load category pie chart');
        });
    }

    function loadTopItemsBar(days) {
        $.get('/api/admin/top_selling_items', { days: days, take: 5 }, function (res) {
            var barRows = (res && res.items) ? res.items : [];
            var labels = [];
            var qtyVals = [];

            barRows.forEach(function (r) {
                labels.push(r.item_name ? String(r.item_name) : 'Item');
                qtyVals.push(parseInt(r.qty_sold, 10) || 0);
            });
            if (!labels.length) {
                labels.push('No sales');
                qtyVals.push(0);
            }
            var hasData = barRows.length > 0;

            if (topItemsBarChart) topItemsBarChart.destroy();

            topItemsBarChart = new Chart(document.getElementById('topItemsBarChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Units sold',
                        data: qtyVals,
                        backgroundColor: hasData ? 'rgba(23,162,184,0.75)' : 'rgba(206,212,218,0.6)',
                        borderColor: hasData ? '#17a2b8' : '#adb5bd',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    legend: { display: false },
                    scales: {
                        xAxes: [{
                            gridLines: { display: false },
                            ticks: { autoSkip: false, maxRotation: 45, minRotation: 0 }
                        }],
                        yAxes: [{
                            gridLines: { color: 'rgba(0,0,0,0.06)' },
                            ticks: {
                                beginAtZero: true,
                                precision: 0,
                                callback: function (v) { return v; }
                            }
                        }]
                    },
                    tooltips: {
                        callbacks: {
                            title: function (items) {
                                if (!hasData || !items.length) return '';
                                var idx = items[0].index;
                                var name = labels[idx];
                                return name || '';
                            },
                            label: function (tooltipItem) {
                                if (!hasData) return 'Try a wider date range.';
                                var i = tooltipItem.index;
                                var q = qtyVals[i] != null ? qtyVals[i] : 0;
                                var mk = '';
                                var r = barRows[i];
                                if (r && r.total_income != null) {
                                    mk = ' · ' + formatMmk(parseFloat(r.total_income)) + ' MMK';
                                }
                                return 'Sold: ' + q + mk;
                            }
                        }
                    }
                }
            });
        }).fail(function () {
            console.error('Failed to load top items chart');
        });
    }
</script>
}
}
